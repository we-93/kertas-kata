# ========================================================
# KERTAS KATA BACKEND - ENVIRONMENT VARIABLES
# ========================================================

PORT=5000
NODE_ENV=development

# Database Connection (MySQL / MariaDB bawaan aaPanel)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="mysql://root:root@localhost:3306/kertas_kata"

# JWT Authentication
JWT_SECRET="kertas_kata_jwt_secret_key_tangerang_2026_super_secure"
JWT_EXPIRES_IN="7d"

# Google OAuth 2.0 Client ID (dapat diperoleh dari Google Cloud Console)
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"

# AI Koreksi Service (Google Gemini API - Free Tier)
GEMINI_API_KEY=""

# Server & Client URLs
APP_URL="http://localhost:5000"
CLIENT_URL="http://127.0.0.1:8080"
